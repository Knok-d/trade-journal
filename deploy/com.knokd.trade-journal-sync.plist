<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.knokd.trade-journal-sync</string>

  <!-- Ключи биржи лежат в Keychain пользователя, поэтому это LaunchAgent
       (сессия пользователя), а не LaunchDaemon: демон работает до входа в
       систему и до связки ключей не дотянется. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_PROJECT/deploy/sync.sh</string>
  </array>

  <!-- Раз в 30 минут. launchd сам догонит пропущенный запуск после сна,
       поэтому закрытая крышка не оставляет дыру в данных. -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <true/>

  <!-- Лог нужен: без него неудачный синк остаётся незамеченным ровно до
       момента, когда цифрам поверят. Дублируется индикатором свежести
       в интерфейсе, но лог отвечает на вопрос «почему». -->
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_HOME/Library/Logs/trade-journal-sync.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_HOME/Library/Logs/trade-journal-sync.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>TRADE_JOURNAL_PROJECT</key>
    <string>REPLACE_WITH_PROJECT</string>
    <!-- Адрес своего сервера: в репозитории его нет, подставляется при установке -->
    <key>TRADE_JOURNAL_REMOTE</key>
    <string>REPLACE_WITH_REMOTE</string>
  </dict>

  <!-- Низкий приоритет: фоновая задача не должна мешать работе. -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
