# HTTPS для Telegram Mini App. Caddy сам получает и продлевает сертификат
# Let's Encrypt — покупать сертификат у регистратора не нужно.
#
# Требует: A-запись домена на этот сервер и открытый порт 80 (проверка владения).
#
# Заменить example.com на свой домен перед копированием в /etc/caddy/Caddyfile.

example.com {
	encode gzip

	# Приложение слушает только 127.0.0.1 — наружу оно смотрит через Caddy,
	# который единственный владеет сертификатом.
	reverse_proxy 127.0.0.1:8321

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Логи идут в journald (поведение Caddy по умолчанию), только ошибки:
	# история обращений не должна копиться в долгоживущем файле, а ротацию
	# journald берёт на себя. Файловый вывод в /var/log/caddy песочница
	# systemd-юнита из пакета Caddy не пропускает — воевать с ней незачем.
	log {
		level ERROR
	}
}
